# CampusAccord Configuration Template
# Copy this file to .env.local for local development. Never commit .env or secrets to Git!

# ==============================================================================
# Application Mode
# ==============================================================================
# 'demo' enables isolated mock data, instant role switching, and deterministic AI simulation
# 'production' connects to live Firebase and your server-side Gemini API
VITE_APP_MODE=demo

# ==============================================================================
# Firebase Web Client Configuration (Public Web Client SDK)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==============================================================================
VITE_FIREBASE_API_KEY=AIzaSyDuqiLAn9vhkdxALmUUPsVdKr8N_EnCkIU
VITE_FIREBASE_AUTH_DOMAIN=campusaccord.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campusaccord
VITE_FIREBASE_STORAGE_BUCKET=campusaccord.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=11813488329
VITE_FIREBASE_APP_ID=1:11813488329:web:911a9492e5634b218baf18
VITE_FIREBASE_MEASUREMENT_ID=G-WBFEM0ZPEG

# ==============================================================================
# Backend / Serverless API Base URL (For secure Gemini proxy & Admin operations)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:3001/api

# ==============================================================================
# Server-Side Configuration (NEVER expose to frontend or client bundle!)
# ==============================================================================
# Google AI Studio Gemini API Key (Server only)
GEMINI_API_KEY=AIzaSy_YOUR_PRIVATE_GEMINI_API_KEY_HERE
# Preferred Gemini Model ID
GEMINI_MODEL=gemini-2.5-flash

# Admin Bootstrap Secret (Used server-side to authorize initial system administrator provisioning)
ADMIN_BOOTSTRAP_SECRET=campus_accord_bootstrap_secret_change_me_in_prod

# Campus Defaults
CAMPUS_NAME=Apex Institute of Technology
CAMPUS_TIMEZONE=Asia/Kolkata
PORT=3001
